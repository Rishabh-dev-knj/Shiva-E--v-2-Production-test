{
    "version": 2,
    "builds": [
        {
            "src": "server/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "client/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/server/index.js"
        },
        {
            "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|svg|ico|webp)$",
            "destination": "/client/$1.$2"
        },
        {
            "source": "/(.*)",
            "destination": "/client/index.html"
        }
    ]
}